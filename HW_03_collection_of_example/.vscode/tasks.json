{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "HW03",
            "type": "shell",
            "command": "make",
            "args": [
                "CC=gcc",              // Используем GCC
                "CFLAGS=-fanalyzer",    // Включаем статический анализ
                "-j4"                  // Параллельная сборка (4 потока)
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],  // Парсинг ошибок GCC
            "options": {
                "cwd": "${workspaceFolder}"  // Рабочая директория
            }
        }
    ]

}
    
